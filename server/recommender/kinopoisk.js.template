  function ratingKey(card) {
    var year = String(card.release_date || card.first_air_date || '').slice(0, 4);
    if (card.kinopoisk_id) return 'kp:' + card.kinopoisk_id;
    if (card.imdb_id) return 'imdb:' + card.imdb_id;
    if (card.id) return (card.name || card.first_air_date ? 'tv:' : 'movie:') + card.id;
    return 'title:' + String(card.original_title || card.title || '').toLowerCase() + ':' + year;
  }

  function ratingCache() {
    return Lampa.Storage.cache('roman_card_ratings_v10', 800, {});
  }

  function cacheGet(key) {
    var cache = ratingCache();
    var item = cache[key];
    if (!item || Date.now() - item.saved_at > ratingCacheTtl) return null;
    return item.data;
  }

  function cacheSet(key, value) {
    var cache = ratingCache();
    cache[key] = { saved_at: Date.now(), data: value };
    Lampa.Storage.set('roman_card_ratings_v10', cache);
  }

  function ratingText(label, value) {
    var number = parseFloat(value);
    if (!isFinite(number) || number <= 0) return '';
    return label + ' ' + number.toFixed(1);
  }

  function ownRatingText(value) {
    var number = parseInt(value, 10);
    return isFinite(number) && number > 0 ? 'МОЯ ' + number : '';
  }

  function platformText(data) {
    if (!data.origin_platform || parseFloat(data.origin_platform_confidence || 0) < 0.85) return '';
    var labels = {
      apple_tv: 'Apple TV+', netflix: 'N', prime_video: 'prime video',
      disney_plus: 'Disney+', hulu: 'hulu', max: 'max',
      paramount_plus: 'Paramount+', peacock: 'peacock', kinopoisk: 'КИНОПОИСК',
      okko: 'okko', start: 'START', premier: 'PREMIER', wink: 'WINK',
      hbo: 'HBO', amc: 'AMC', fx: 'FX', bbc: 'BBC', showtime: 'SHOWTIME',
      starz: 'STARZ', nbc: 'NBC', cbs: 'CBS', abc: 'ABC', fox: 'FOX', cw: 'THE CW'
    };
    return labels[data.origin_platform] || data.origin_platform_label || '';
  }

  function drawCardRatings(element, data) {
    if (!element) return;
    var card = element.card_data || {};
    if (data && data.found !== undefined) element.romanRatingsData = data;
    data = Object.assign({}, reviewForCard(card) || {}, element.romanRatingsData || {}, data || {});
    var view = element.querySelector('.card__view');
    if (!view) return;
    element.classList.add('roman-unified-ratings');
    var nativeVote = view.querySelector('.card__vote');
    if (nativeVote) nativeVote.style.display = 'none';
    var fire = view.querySelector('.roman-fire-count');
    if (card.cub_hundred_fire && !fire) {
      fire = document.createElement('div');fire.className='roman-fire-count';
      fire.style.cssText='position:absolute;bottom:.3em;right:.3em;background:#15151ccc;color:white;border-radius:.5em;padding:.2em .4em';
      fire.textContent='🔥 '+(Number(card.cub_hundred_fire)>=1000 ? (Number(card.cub_hundred_fire)/1000).toFixed(1)+'K' : card.cub_hundred_fire);
      view.appendChild(fire);
    }
    var old = view.querySelector('.roman-card-ratings');
    if (old) old.remove();
    var values = [
      ['platform', platformText(data), data.origin_platform],
      ['kp', ratingText('КП', data.kp_rating), ''],
      ['imdb', ratingText('IMDb', data.imdb_rating), ''],
      ['tmdb', ratingText(card.cub_hundred_rating ? 'CUB' : 'Каталог', card.cub_hundred_rating || card.vote_average), ''],
      ['mine', ownRatingText(data.my_rating), ''],
      ['prediction', ratingText('Прогноз ≈', data.predicted_rating), '']
    ].filter(function (item) { return !!item[1]; });
    if (!values.length) return;
    var wrap = document.createElement('div');
    wrap.className = 'roman-card-ratings';
    values.forEach(function (item) {
      var badge = document.createElement('div');
      badge.className = 'roman-card-rating roman-card-rating--' + item[0];
      if (item[0] === 'platform' && item[2]) badge.className += ' roman-platform--' + item[2];
      badge.textContent = item[1];
      wrap.appendChild(badge);
    });
    view.appendChild(wrap);
  }

  function requestParams(card) {
    var type = card.name || card.first_air_date || card.media_type === 'tv' ? 'tv' : 'movie';
    var year = String(card.release_date || card.first_air_date || card.last_air_date || '').slice(0, 4);
    return [
      'tmdb_id=' + encodeURIComponent(card.id || card.tmdb_id || ''),
      'kp_id=' + encodeURIComponent(card.kinopoisk_id || ''),
      'imdb_id=' + encodeURIComponent(card.imdb_id || ''),
      'cached=1',
      'type=' + type,
      'title=' + encodeURIComponent(card.title || card.name || ''),
      'original_title=' + encodeURIComponent(card.original_title || card.original_name || ''),
      'year=' + encodeURIComponent(year)
    ].join('&');
  }

  function pumpRatingQueue() {
    while (ratingActive < ratingMaxParallel && ratingQueue.length) {
      (function (job) {
        ratingActive++;
        var request = new Lampa.Reguest();
        request.timeout(20000);
        request.silent(CARD_RATINGS_URL + '?' + requestParams(job.card), function (json) {
          cacheSet(job.key, json || { found: false });
          job.elements.forEach(function (element) { drawCardRatings(element, json); });
          ratingActive--;
          pumpRatingQueue();
        }, function () {
          ratingActive--;
          pumpRatingQueue();
        });
      })(ratingQueue.shift());
    }
  }

  function processCard(element) {
    drawLastHomeEpisode(element);
    refreshContinueCard(element);
    if (element && element.card_data) {
      var review = reviewForCard(element.card_data);
      if (review) {
        markReview(element, review);
        drawCardRatings(element, {});
      }
    }
    if (!element || element.dataset.romanRatingsQueued === '1') return;
    var card = element.card_data;
    if (!card) return;
    drawCardRatings(element, {});
    element.dataset.romanRatingsQueued = '1';
    var key = ratingKey(card);
    var cached = cacheGet(key);
    if (cached) {
      drawCardRatings(element, cached);
      return;
    }
    for (var i = 0; i < ratingQueue.length; i++) {
      if (ratingQueue[i].key === key) {
        ratingQueue[i].elements.push(element);
        return;
      }
    }
    ratingQueue.push({ key: key, card: card, elements: [element] });
    pumpRatingQueue();
  }

  function scanCards(root) {
    if (!root || root.nodeType !== 1) return;
    if (root.classList && root.classList.contains('card')) processCard(root);
    if (root.querySelectorAll) {
      Array.prototype.forEach.call(root.querySelectorAll('.card'), processCard);
    }
  }

  function observeCards() {
    installRatingStyle();
    scanCards(document.body);
    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        var host=mutation.target && mutation.target.closest && mutation.target.closest('.card');
        if(host) drawLastHomeEpisode(host);
        Array.prototype.forEach.call(mutation.addedNodes || [], scanCards);
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }

  function homeBack() {
    var top=Lampa.Controller.windowTop && Lampa.Controller.windowTop();
    var overlay=top || document.querySelector('.modal,.player,.search-box,.search') ||
      document.body.classList.contains('settings--open') || document.body.classList.contains('selectbox--open');
    if (overlay) {
      if (top && top.name) Lampa.Controller.toggle(top.name);
      var current=Lampa.Controller.enabled();
      if (current && current.controller && current.controller.back) Lampa.Controller.back();
      else if (document.body.classList.contains('selectbox--open') && Lampa.Select) Lampa.Select.close();
      else if (document.querySelector('.modal') && Lampa.Modal) Lampa.Modal.close();
      else Lampa.Controller.back();
    } else {
      var screens=Lampa.Activity.all();
      var activity=Lampa.Activity.active();
      // A restored card/deep link can be the only activity. Native backward()
      // deliberately does nothing there: replace that root with home instead.
      if (screens.length===1 && activity && activity.component!=='main') {
        var source=Lampa.Storage.field('source') || 'cub';
        Lampa.Activity.replace({url:'',title:Lampa.Lang.translate('title_main')+' - '+source.toUpperCase(),
          component:'main',source:source,page:1},true);
      } else if (screens.length>1) Lampa.Activity.backward();
    }
  }

  function installHomeUiPolish() {
    if (window.HomeCinemaUiV1) return;
    window.HomeCinemaUiV1=true;
    document.addEventListener('click',function (event) {
      var button=event.target && event.target.closest && event.target.closest('.head__backward');
      if (!button || (typeof event.button==='number' && event.button!==0)) return;
      event.preventDefault();event.stopImmediatePropagation();
      homeBack();
    },true);
    // Native facts call CUB AI. Published KP facts need no CUB account.
    Lampa.Component.add('ai_facts',factsComponent);
    Lampa.Component.add('facts',factsComponent);
  }

  function factsComponent(object) {
    var Base=Lampa.Component.get && Lampa.Component.get('nocomponent');
    var comp=Base ? new Base(object) : new Lampa.InteractionCategory(object);
    var scroll, body, root, xhr, gone=false, selected=0;
    var movie=object.card || object.movie || {};
    var personal=reviewForCard(movie) || {};
    var kp=String(movie.kinopoisk_id || movie.kp_id || personal.kp_id || '');
    var type=movie.name || movie.first_air_date || movie.media_type==='tv' ? 'tv' : 'movie';
    function sourceButton(source) {
      if (!/^https:\/\/www\.kinopoisk\.ru\/(?:series|film)\/[1-9][0-9]*\/didyouknow\/$/.test(source || '')) return;
      var button=$('<div class="simple-button selector homecinema-facts__source">Источник: Кинопоиск ↗</div>');
      button.on('hover:enter',function () {window.open(source,'_blank','noopener');});body.append(button);
    }
    function focus(index) {
      var nodes=body.find('.selector');
      selected=Math.max(0,Math.min(index,nodes.length-1));
      if (nodes.length) {Lampa.Controller.collectionFocus(nodes.eq(selected));scroll.update(nodes.eq(selected));}
    }
    function draw(data) {
      if (gone) return;
      body.empty();
      $('<h2></h2>').text('Интересные факты — '+(movie.name || movie.title || '')).appendTo(body);
      var items=data.items || [];
      if (!items.length) {
        $('<p></p>').text(data.error || 'На странице Кинопоиска пока не удалось найти опубликованные факты.').appendTo(body);
        if (movie.overview) {
          $('<h3></h3>').text('О фильме или сериале').appendTo(body);
          $('<p></p>').text(movie.overview).appendTo(body);
        }
      }
      items.forEach(function (item) {
        var article=$('<div class="selector homecinema-fact"></div>');
        if (item.spoiler) {
          var button=$('<div class="homecinema-fact__spoiler">Спойлер — нажмите, чтобы показать</div>');
          var text=$('<p></p>').text(item.text).hide();article.append(button).append(text);
          article.on('hover:enter',function () {text.toggle();button.toggle();});
        } else $('<p></p>').text(item.text).appendTo(article);
        article.on('hover:focus',function () {selected=body.find('.selector').index(this);});
        body.append(article);
      });
      sourceButton(data.source_url);
      if (Lampa.Activity.active() && Lampa.Activity.active().activity===comp.activity) comp.start();
    }
    comp.create=function () {
      root=$('<div class="homecinema-facts"></div>');
      body=$('<div class="homecinema-facts__body"><p>Загружаем факты Кинопоиска…</p></div>');
      scroll=new Lampa.Scroll({mask:true,over:true});scroll.append(body);root.append(scroll.render());
      if (this.emit) this.emit('create');
      this.activity.loader(false);this.activity.toggle();
      if (!/^[1-9][0-9]{0,9}$/.test(kp)) {
        draw({items:[],error:'Для этой карточки пока не определён ID Кинопоиска.'});return;
      }
      xhr=new XMLHttpRequest();xhr.open('GET',reviewBase+'/facts/kp/'+kp+'.json?type='+type,true);xhr.timeout=22000;
      xhr.onload=function () {
        try {if(xhr.status!==200) throw new Error('HTTP');draw(JSON.parse(xhr.responseText));}
        catch (_) {draw({error:'Факты временно недоступны. Попробуйте открыть раздел ещё раз.'});}
      };
      xhr.onerror=xhr.ontimeout=function () {draw({error:'Не удалось загрузить факты. Проверьте соединение с сервером.'});};xhr.send();
    };
    comp.start=function () {
      Lampa.Controller.add('content',{
        toggle:function () {Lampa.Controller.collectionSet(root);focus(selected);},
        up:function () {if(selected===0)Lampa.Controller.toggle('head');else focus(selected-1);},
        down:function () {focus(selected+1);},
        enter:function () {body.find('.selector').eq(selected).trigger('hover:enter');},
        back:function () {Lampa.Activity.backward();}
      });
      Lampa.Controller.toggle('content');
    };
    comp.render=function () {return root;};
    comp.pause=function () {};comp.stop=function () {};
    comp.destroy=function () {gone=true;if(xhr)xhr.abort();if(scroll)scroll.destroy();if(root)root.remove();if(comp.emit)comp.emit('destroy');};
    return comp;
  }

  function start() {
    if (window.romanKinopoiskStarted) return;
    installHomeUiPolish();
    installHomeNavigation();
    installTailLoading();
    Lampa.Component.add(COMPONENT, component);
    Lampa.Component.add(REVIEW_COMPONENT, reviewComponent);
    Lampa.Component.add(SHELF_COMPONENT, shelfComponent);
    installAiHome();
    Lampa.Listener.follow('full', addRatingToFull);
    Lampa.Listener.follow('full', addReviewActions);
    observeCards();
    window.romanKinopoiskStarted = true;
    loadData(function () {});
    if (window.appready) addMenu();
    else Lampa.Listener.follow('app', function (event) {
      if (event.type === 'ready') addMenu();
    });
  }

  start();
})();
