  function filterReleaseCards(cards) {
    return (cards || []).filter(function (card) {
      var quality = String(card.release_quality || card.quality || '').toUpperCase();
      if (/WEB[- .]?(DL|RIP)|BLU[- .]?RAY|BDRIP|BRRIP|DVDRIP|HDTV/.test(quality)) return true;
      return !/(^|[^A-Z])(HD)?(TS|CAM|CAMRIP|TC)([^A-Z]|$)|TELESYNC|TELECINE|SCREENER|DVDSCR|WORKPRINT|VHSRIP/.test(quality);
    });
  }

  function homeRowKind(row) {
    var title=String(row.title || '').replace(/<[^>]*>/g,'').replace(/#\{([^}]+)\}/g,function(_,key) {
      return Lampa.Lang.translate(key);
    }).trim().toLowerCase();
    var route=String(row.url || row.name || '').toLowerCase();
    function label(key) {return String(Lampa.Lang.translate(key)).toLowerCase();}
    if (/tv\s+series\s+i\s+(?:have|gave)\s+seen|movies?\s+i\s+have\s+seen/i.test(title)) return 'hidden';
    if (/трейлер|trailer/.test(title+' '+route) || title.indexOf(label('title_trailers'))===0) return 'hidden';
    if (title===label('title_latest') || title===label('title_in_high_quality') ||
        /^(последни[ее] добавлен|последнее добавление|в высоком качестве|uhd\b)/.test(title) ||
        /[?&]uhd=true|[?&]sort=latest(?:&|$)/.test(route)) return 'hidden';
    if (title===label('title_continue') || /продолжить просмотр|продолжение просмотра|continue watching/.test(title) || route==='continue') return 'continue';
    if (route==='roman-ai://recent' || route==='roman-ai://recommendations') return 'ai';
    if (title===label('title_fire') || /^огонь[!\s]*$/.test(title) || /top\/fire\//.test(route)) return 'fire';
    if (title===label('title_now_watch') || /^сейчас смотрят/.test(title) || /sort=now_playing/.test(route)) return 'now';
    if (route==='roman-ai://archive') return 'archive';
    if (route==='roman-kp://watchlist' || /^(буду смотреть|запланировано)$/.test(title)) return 'watch';
    if (title===label('title_recomend_watch') || title==='рекомендуем посмотреть') return 'stock_ai';
    return 'other';
  }

  function hiddenHomeRow(row) {return homeRowKind(row)==='hidden';}

  function orderHomeRows(rows) {
    var ranks={continue:0,ai:1,fire:2,now:3,archive:4,watch:5,stock_ai:1,other:6};
    var personal=rows.some(function(row) {return homeRowKind(row)==='ai';});
    var ownWatch=rows.some(function(row) {return row.url==='roman-kp://watchlist';});
    return rows.filter(function(row) {
      var kind=homeRowKind(row);
      return kind!=='hidden' && !(kind==='stock_ai' && personal) &&
        !(kind==='watch' && ownWatch && row.url!=='roman-kp://watchlist');
    }).map(function(row,index) {
      return {row:row,index:index,rank:ranks[homeRowKind(row)]};
    }).sort(function(a,b) {return a.rank-b.rank || a.index-b.index;})
      .map(function(item) {return item.row;});
  }

  function personalizeNow(cards) {
    return cards.map(function (card,index) {
      var personal=reviewForCard(card), prediction=personal && personal.predicted_rating;
      var cached=cacheGet(ratingKey(card));
      if (cached && cached.predicted_rating != null) prediction=cached.predicted_rating;
      var score=1-(index / Math.max(1,cards.length))*.25;
      if (prediction != null) score *= Math.max(.7,Math.min(1.3,1+(prediction-6)*.12));
      // An existing rating means watched, never a popularity boost.
      return {card:card,score:score,index:index};
    }).sort(function(a,b) {return b.score-a.score || a.index-b.index;}).map(function(x) {return x.card;});
  }

  function openNowShelf() {
