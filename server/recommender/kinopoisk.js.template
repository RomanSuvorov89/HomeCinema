  function shelfComponent(object) {
    var comp=new Lampa.InteractionCategory(object), snapshot=null;
    function read() {
      if(snapshot) return snapshot;
      var stored=Lampa.Storage.get('roman_home_shelves_v5',{});
      if(stored.now && stored.now.row && Array.isArray(stored.now.row.results))
        return snapshot=Promise.resolve(stored.now.row.results.slice());
      return snapshot=reviewRequest('/home.json').then(function(data){
        var row=(data.rows || []).find(function(r){return r.kind==='now';});
        return row && row.results || [];
      });
    }
    function page(number,done,failed) {
      read().then(function(cards){
        cards=filterReleaseCards(cards).filter(function(card){
          return card.roman_review && typeof card.roman_review.predicted_rating==='number';
        });
        cards.forEach(function(card){
          var item=card.roman_review;
          reviewItems[String(item.kp_id)]=item;
          reviewCards[(card.media_type || item.media_type)+':'+card.id]=item;
        });
        done({results:cards.slice((number-1)*12,number*12),page:number,
          total_pages:Math.max(1,Math.ceil(cards.length/12)),total_results:cards.length,nomore:number*12>=cards.length});
      }).catch(function(){if(failed) failed();});
    }
    comp.create=function(){page(Number(object.page || 1),this.build.bind(this),this.empty.bind(this));};
    comp.nextPageReuest=function(params,resolve){page(Number(params.page || 2),resolve,function(){resolve({results:[],nomore:true});});};
    return comp;
  }

  function installCatalogPageCache() {
    var key='roman_catalog_pages_v2', active={};
    var pages=Lampa.Storage.get(key,{});
    ['cub','tmdb'].forEach(function(source) {
      var api=Lampa.Api.sources[source];
      if(!api || typeof api.list!=='function' || api.list.romanPageCache) return;
      var native=api.list;
      api.list=function(params,done,failed) {
        // Search requests keep their own identity cache; cache browse pages only.
        if(!params || /search/.test(params.url || '')) return native.apply(this,arguments);
        // Only request fields belong to a cache key. Activity/DOM objects may
        // contain cycles and must never enter JSON.stringify.
        var request={};
        ['url','page','query','genres','sort','language','region','method'].forEach(function(k){
          if(params[k]!=null && /^(string|number|boolean)$/.test(typeof params[k])) request[k]=params[k];
        });
        if(params.filter && typeof params.filter==='object') {
          request.filter={};
          Object.keys(params.filter).sort().forEach(function(k){
            if(params.filter[k]!=null && /^(string|number|boolean)$/.test(typeof params.filter[k])) request.filter[k]=params.filter[k];
          });
        }
        var id=source+':'+JSON.stringify(request), saved=pages[id], answered=false;
        if(saved && Array.isArray(saved.data.results)) {answered=true;done(saved.data);}
        if(answered && active[id]) return;
        active[id]=true;
        return native.call(this,params,function(json) {
          if(json && Array.isArray(json.results)) {
            pages[id]={at:Date.now(),data:json};
            var ids=Object.keys(pages).sort(function(a,b){return pages[b].at-pages[a].at;});
            ids.slice(160).forEach(function(old){delete pages[old];});
            try {Lampa.Storage.set(key,pages);} catch(error) {}
          }
          if(!answered)done(json);
        },function(error){if(!answered && failed)failed(error);});
      };
      api.list.romanPageCache=true;
    });
  }

  function installAiHome() {
    var cub = Lampa.Api.sources.cub;
    if (!cub || cub.main.romanAiHome) return;
    var original = cub.main;
    installCatalogPageCache();
    ['cub','tmdb'].forEach(function (sourceName) {
      var api=Lampa.Api.sources[sourceName];
      if(!api) return;
      ['get','list'].forEach(function (method) {
        var originalRequest=api[method];
        if(typeof originalRequest!=='function' || originalRequest.romanQuality) return;
        var callbackIndex=method==='get'?2:1;
        api[method]=function () {
          var args=Array.prototype.slice.call(arguments),callback=args[callbackIndex];
          if(typeof callback==='function') args[callbackIndex]=function (json) {
            if(json && Array.isArray(json.results)) {
              var cards=filterReleaseCards(json.results);
              if(args[0] && args[0].url==='continue') cards=continueHomeCards(cards);
              json=Object.assign({},json,{results:cards});
            }
            return callback(json);
          };
          return originalRequest.apply(this,args);
        };
        api[method].romanQuality=true;
      });
    });
    // Server materializes these rows on a timer; opening Lampa only reads a snapshot.
    var preview = null, previewRevision = -1, previewAt=0;
    function loadPreview() {
      if (preview && previewRevision === homeFeedbackRevision && Date.now()-previewAt<60000) return preview;
      previewAt=Date.now();
      previewRevision = homeFeedbackRevision;
      var requestRevision = homeFeedbackRevision;
      preview = new Promise(function (resolve) {
        var net = new Lampa.Reguest();
        net.timeout(1200);
        net.silent(reviewBase + '/home.json', function (snapshot) {
          if (!snapshot || !Array.isArray(snapshot.rows)) return resolve(null);
          if(Array.isArray(snapshot.series_releases)) {
            Lampa.Storage.set('roman_home_shelves_releases_v1',{items:snapshot.series_releases});
            refreshContinueCards();
          }
          if (requestRevision === homeFeedbackRevision && Array.isArray(snapshot.hidden_ids)) {
            var hidden = {};snapshot.hidden_ids.forEach(function(kp){hidden[String(kp)]=true;});
            Lampa.Storage.set('roman_hidden_home_v1',hidden);
          }
          var rows = snapshot.rows.map(function (row) {
            row = Object.assign({},row,{results:filterReleaseCards(row.results || [])});
            row.results.forEach(function(card) {
              if(card.roman_review) {
                var item=card.roman_review;
                reviewItems[String(item.kp_id)]=item;
                reviewCards[(card.media_type || item.media_type)+':'+card.id]=item;
              }
            });
            if(row.kind==='ai' || row.kind==='archive') {
              var period=row.kind==='ai'?'recent':'archive';
              row.url='roman-ai://'+period;row.source='cub';row.page=1;row.total_pages=2;
              row.params={emit:{onlyMore:function(){openReviewList(period);}}};
            }
            if(row.kind==='fire' || row.kind==='now') {
              row.source='cub';row.page=1;row.total_pages=2;
              var personalNow=row.kind==='now' && row.results.some(function(c){return c.roman_review && typeof c.roman_review.predicted_rating==='number';});
              row.url=row.kind==='fire'?'top/fire/movie':personalNow?'roman-home://now':'?sort=now_playing';
              if(personalNow) row.params={emit:{onlyMore:openNowShelf}};
              if(row.kind==='fire' && Lampa.Template && Lampa.Template.string) {
                row.icon_svg=Lampa.Template.string('icon_fire');row.icon_bgcolor='#fff';row.icon_color='#fd4518';
              }
            }
            if(/^(continue|ai|archive|now)$/.test(row.kind)) row.results=hiddenHomeCards(row.results);
            if(row.kind==='continue') {row.url='continue';row.source='cub';row.page=1;}
            if(row.kind==='watch') {
              row.results=combinedWatchCards(row.results);
              row.url='roman-kp://watchlist';row.source='cub';row.page=1;row.total_pages=2;
              row.params={emit:{onlyMore:openWatchlist}};
            }
            // Remember valid snapshots even if this startup already displayed local rows.
            remember(row.kind,row);
            return row;
          });
          resolve(rows);
        },function(){resolve(null);});
      });
      return preview;
    }
    // Covers older Lampa versions that use Activity rather than onlyMore.
    var push = Lampa.Activity.push;
    Lampa.Activity.push = function (params) {
      if(params && params.url==='roman-home://now') params=Object.assign({},params,{url:'',title:'Сейчас смотрят',component:SHELF_COMPONENT,page:1});
      if(params && params.url==='roman-kp://watchlist') {
        params=Object.assign({},params,{url:'',title:'Буду смотреть',component:COMPONENT,page:1});
      }
      if (params && /^roman-ai:\/\/(recent|archive|recommendations)$/.test(params.url || '')) {
        var period=params.url.split('/').pop();
        params = Object.assign({},params,{url:'',title:'Рекомендация AI',component:REVIEW_COMPONENT,page:1,review_period:period==='archive'?'archive':'recent'});
      }
      return push.call(this,params);
    };
    // Cache each priority shelf independently; never wait for unrelated shelves.
    var homeCacheKey='roman_home_shelves_v5';
    var homeCache=Lampa.Storage.get(homeCacheKey,{});
    if(!homeCache || typeof homeCache!=='object') homeCache={};
    function remembered(key) {
      var row=homeCache[key] && homeCache[key].row;
      if(!row || !Array.isArray(row.results)) return null;
      row=Object.assign({},row,{results:row.results.slice()});
      row.results.forEach(function(card) {
        if(card.roman_review) {
          var item=card.roman_review;
          reviewItems[String(item.kp_id)]=item;
          reviewCards[(card.media_type || item.media_type)+':'+card.id]=item;
        }
      });
      if(/^(continue|ai|archive|now)$/.test(key)) row.results=hiddenHomeCards(row.results);
      if(key==='ai' || key==='archive') row.params={emit:{onlyMore:function(){openReviewList(key==='ai'?'recent':'archive');}}};
      if(key==='now' && row.url==='roman-home://now') row.params={emit:{onlyMore:openNowShelf}};
      if(key==='watch') row.results=combinedWatchCards(row.results);
      if(key==='watch') row.params={emit:{onlyMore:openWatchlist}};
      return row;
    }
    function remember(key,row) {
      if(!row || !Array.isArray(row.results)) return;
      // A valid empty result clears stale content; network failures do not.
      homeCache[key]={row:row,at:Date.now()};
      try {Lampa.Storage.set(homeCacheKey,homeCache);} catch(error) {}
    }
    function cachedTask(key,loader,callback) {
      var cached=remembered(key);
      var answered=false;
      function answer(row) {if(answered)return;answered=true;callback(row);}
      if(cached) answer(cached);
      if(cached) return;
      if(key==='fire' || key==='now') loadPreview().then(function(rows) {
        if(Array.isArray(rows)) {
          var row=rows.find(function(r){return r.kind===key;});
          if(row) answer(row);
