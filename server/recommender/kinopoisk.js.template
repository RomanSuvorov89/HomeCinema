    var Native=Lampa.Component.get && Lampa.Component.get('torrents');
    if(typeof Native==='function' && !Native.homecinemaScopedSeason) {
      function Scoped(object) {
        var instance=new Native(object), get=instance.getFilterData, set=instance.setFilterData;
        if(typeof get==='function' && typeof set==='function') {
          instance.getFilterData=function() {
