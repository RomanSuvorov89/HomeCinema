    }
    function taskKind(task) {
      var text=Function.prototype.toString.call(task);
      if(/TV Series I (?:Have|Gave) Seen/i.test(text)) return 'hidden';
      if(/title_trailers|\btrailers\s*\(|sort=latest|title_latest|title_in_high_quality|uhd=true/.test(text)) return 'hidden';
      if(/title_continue|continue_watch|Продолжить просмотр/.test(text)) return 'continue';
      if(/title_fire|top\/fire\/|Огонь!/.test(text)) return 'fire';
      if(/title_now_watch|sort=now_playing|Сейчас смотрят/.test(text)) return 'now';
      if(/title_recomend_watch|Рекомендуем посмотреть/.test(text)) return 'stock_ai';
      if(/Буду смотреть/.test(text)) return 'watch';
      return 'other';
    }
    function personalTask(kind,callback) {
      cachedTask(kind,function(done) {
        loadPreview().then(function(rows) {
          if(!Array.isArray(rows)) return done(null);
          done(rows.find(function(row){return homeRowKind(row)===kind;}) ||
            null);
        },function(){done(null);});
      },callback);
    }
    function watchTask(callback) {
      cachedTask('watch',function(done) {
        loadPreview().then(function(rows) {
          if(!Array.isArray(rows)) return done({title:'Буду смотреть',kind:'watch',url:'roman-kp://watchlist',results:combinedWatchCards([])});
          var row=rows.find(function(row){return row.kind==='watch';}) || {title:'Буду смотреть',kind:'watch',url:'roman-kp://watchlist',results:[]};
          done(Object.assign({},row,{results:combinedWatchCards(row.results)}));
        },function(){done(null);});
      },callback);
    }
    var activePlan=null;
    // Native partNext waits for six callbacks and recursively seeks three rows.
    // On a clean client that can hold even Continue Watching behind TMDB timeouts.
    // Keep in-flight tasks for subsequent pages; late replies are never discarded.
    if (typeof Lampa.Api.partNext==='function' && !Lampa.Api.partNext.romanBoundedHome) {
      var nativePartNext=Lampa.Api.partNext;
      Lampa.Api.partNext=function(parts,limit,loaded,empty) {
        if(!parts.romanHomePlan) return nativePartNext.apply(this,arguments);
        var pending=parts.filter(function(task){return typeof task==='function';});
        if(!pending.length) return empty();
        pending.sort(function(a,b){return (a.romanRank==null?6:a.romanRank)-(b.romanRank==null?6:b.romanRank);});
        var chosen=pending.slice(0,limit), ended=false, timer;
        var homeTail=null;
        if(typeof $==='function') {
          var root=$('.activity:visible').last();
          if(root.length){homeTail=$('<div class="roman-loading-tail" role="status" aria-label="Загрузка разделов"><i></i></div>');var host=root.find('.scroll__body').first();(host.length?host:root).append(homeTail);}
        }
        function finish() {
          if(ended)return;ended=true;clearTimeout(timer);
          if(homeTail && chosen.every(function(task){return task.romanState && task.romanState.done;}))homeTail.remove();
          var rows=[];
          chosen.forEach(function(task){
            var state=task.romanState;
            if(state && state.done){
              var index=parts.indexOf(task);if(index>=0)parts[index]=false;
              if(state.row && state.row.results && state.row.results.length)rows.push(state.row);
            }
          });
          if(rows.length)loaded(rows);else empty();
        }
        function check() {
          if(homeTail && chosen.every(function(task){return task.romanState && task.romanState.done;})){homeTail.remove();homeTail=null;}
          var readyPrefix=false;
          for(var i=0;i<chosen.length;i++){
            var state=chosen[i].romanState;
            if(!state || !state.done)break;
            if(state.row && state.row.results && state.row.results.length)readyPrefix=true;
          }
          if(readyPrefix || chosen.every(function(task){return task.romanState && task.romanState.done;}))finish();
        }
        timer=setTimeout(finish,1800);
        chosen.forEach(function(task){
          if(!task.romanState){
            var state=task.romanState={done:false,row:null};
            try{task(function(row){state.row=row;state.done=true;check();});}
            catch(error){state.done=true;}
          }
        });
        check();
      };
      Lampa.Api.partNext.romanBoundedHome=true;
    }
    if (Lampa.ContentRows && typeof Lampa.ContentRows.call==='function') {
      var originalRowsCall=Lampa.ContentRows.call;
      Lampa.ContentRows.call=function(screen,params,calls) {
        var result=originalRowsCall.apply(this,arguments);
        var plan=activePlan;
        if(!plan || screen!=='main' || !Array.isArray(calls)) return result;
        plan.captured=true;
        calls.romanHomePlan=plan;
        var tasks=calls.filter(function(task){return typeof task==='function';}).map(function(task,index) {
          return {task:task,kind:taskKind(task),index:index};
        }).filter(function(item){return item.kind!=='hidden' && item.kind!=='stock_ai' && item.kind!=='watch';});
        if(!tasks.some(function(item){return item.kind==='continue';})) tasks.push({kind:'continue',index:0,task:function(cb){personalTask('continue',cb);}});
        tasks.push({kind:'ai',index:tasks.length,task:function(cb){personalTask('ai',cb);}});
        tasks.push({kind:'archive',index:tasks.length,task:function(cb){personalTask('archive',cb);}});
        tasks.push({kind:'watch',index:tasks.length,task:watchTask});
        var ranks={continue:0,ai:1,fire:2,now:3,archive:4,watch:5,other:6};
        tasks.sort(function(a,b){return ranks[a.kind]-ranks[b.kind] || a.index-b.index;});
        calls.length=0;
        tasks.forEach(function(item) {
          if(item.kind!=='other') plan.remaining++;
          var wrapped=function(callback) {
            function completed(row) {
              if(item.kind==='continue') {
                var extra=remembered('continue');
                if(extra && extra.results.length) {
                  row=Object.assign({},row || extra,{title:'Продолжить просмотр'});
                  var cards=(row.results || []).slice();
                  extra.results.forEach(function(card) {
                    if(!cards.some(function(old){return (old.kinopoisk_id && String(old.kinopoisk_id)===String(card.kinopoisk_id)) ||
                        (String(old.id)===String(card.id) && (old.media_type || 'tv')===(card.media_type || 'tv'));})) cards.push(card);
                  });
                  row.results=cards;
                }
              }
              if(row && /^(continue|ai|archive|now)$/.test(item.kind)) row=Object.assign({},row,{results:hiddenHomeCards(row.results)});
              if(item.kind!=='other')plan.remaining--;callback(row);
            }
            if(item.kind==='now' || item.kind==='fire') cachedTask(item.kind,item.task,completed);
            else item.task(completed);
          };
          wrapped.romanRank=ranks[item.kind];
          calls.push(wrapped);
        });
        return result;
      };
    }
    cub.main = function (params, done, failed) {
      loadPreview();
      var plan={captured:false,remaining:0};
      var next;
      function normalize(rows) {
        return orderHomeRows(rows).map(function(row) {
          row=Object.assign({},row,{results:filterReleaseCards(row.results)});
          var kind=homeRowKind(row);
          if(kind==='archive') row.title='Из прошлых лет';
          if(kind==='watch') row.results=combinedWatchCards(row.results);
          if(kind==='continue') row.results=continueHomeCards(row.results);
          if(homeRowKind(row)==='now') {
            if(!row.results.some(function(c){return c.roman_review;})) row.results=personalizeNow(row.results);
            row.title='Сейчас смотрят';
          }
          return row;
        }).filter(function(row){return row.results.length;});
      }
      function intercept(callback,reject) {return function(rows) {
        if(!Array.isArray(rows)) return callback(rows);
        var visible=normalize(rows);
        if(visible.length) return callback(visible);
        Promise.resolve().then(function(){
          if(typeof next==='function') next(intercept(callback,reject),reject || function(){});
          else if(reject) reject();
        });
      };}
      var previous=activePlan;activePlan=plan;
      try {next=original.call(this,params,intercept(done,failed),failed);}
      finally {activePlan=previous;}
      return function(resolve,reject) {
        if(typeof next==='function') return next(intercept(resolve,reject),function() {
          if(reject)reject();
        });
        if(reject) reject();
      };
    };
    cub.main.romanAiHome = true;
    loadPreview();
  }
  var data = null;
  var loading = false;
  var waiters = [];
  var network = new Lampa.Reguest();
  var ratingQueue = [];
  var ratingActive = 0;
  var ratingMaxParallel = 2;
  var ratingCacheTtl = 6 * 60 * 60 * 1000;

  function loadData(done, failed) {
    if (data) return done(data);
    waiters.push({ done: done, failed: failed });
    if (loading) return;
    loading = true;
    network.silent(DATA_URL, function (json) {
      data = json;
      loading = false;
      var list = waiters.splice(0);
      list.forEach(function (item) { item.done(json); });
    }, function () {
      loading = false;
      var list = waiters.splice(0);
      list.forEach(function (item) { if (item.failed) item.failed(); });
    });
  }

  function itemYear(card) {
    var value = card.release_date || card.first_air_date || '';
    return parseInt(String(value).slice(0, 4), 10) || 0;
  }

  function bestResult(item, results) {
    if (!results || !results.length) return null;
    var target = parseInt(item.year, 10) || 0;
    function name(value) {return String(value || '').toLowerCase().replace(/ё/g,'е').replace(/[^a-zа-я0-9]+/g,'');}
    var wanted=name(item.title);
    var matching=results.filter(function (card) {
      return (!target || itemYear(card)===target) &&
        [card.title,card.name,card.original_title,card.original_name].some(function (title) {return wanted && name(title)===wanted;});
    });
    return matching.length===1 ? matching[0] : null;
  }

  function resolveItem(item, done) {
    var cache = Lampa.Storage.get('roman_kinopoisk_cards_v2', {});
    var cached = cache[String(item.kp_id)];
    if (cached) return done(cached);

    var type = item.media_type === 'tv' ? 'tv' : 'movie';
    var filter = {};
    if (item.year) filter[type === 'tv' ? 'first_air_date_year' : 'year'] = item.year;

    var sources = Lampa.Api.sources;
    var sourceName = sources.cub && typeof sources.cub.list === 'function' ? 'cub' : 'tmdb';
    var catalog = sources[sourceName];
    var settled = false, timeout;
    function answer(card) {
      if (settled) return;
      settled = true;
      clearTimeout(timeout);
      done(card);
    }
    if (!catalog || typeof catalog.list !== 'function') {
      if (window.romanClientReport) window.romanClientReport('catalog', 'Public list API unavailable');
      return answer(null);
    }
    timeout = setTimeout(function () { answer(null); }, 5000);
    try {
      catalog.list({
        url: 'search/' + type,
        query: encodeURIComponent(item.title || ''),
        page: 1,
        filter: filter
      }, function (json) {
        if (settled) return;
        var card = bestResult(item, json && json.results);
        if (card) {
          card.media_type = type;
          card.kinopoisk_id = String(item.kp_id);
          card.source = sourceName;
          // Other parallel searches may have updated the cache since this one began.
          var latest = Lampa.Storage.get('roman_kinopoisk_cards_v2', {});
          latest[String(item.kp_id)] = card;
          Lampa.Storage.set('roman_kinopoisk_cards_v2', latest);
        }
        answer(card);
      }, function () { answer(null); });
    } catch (error) {
      if (window.romanClientReport) window.romanClientReport('catalog', error.message || error);
      answer(null);
    }
  }

  function resolveAll(items, complete) {
    var results = new Array(items.length);
    var next = 0;
    var active = 0;
    var finished = 0;

    function pump() {
      if (finished === items.length) {
        complete(results.filter(function (item) { return !!item; }));
        return;
      }
      while (active < 4 && next < items.length) {
        (function (index) {
          active++;
          resolveItem(items[index], function (card) {
            results[index] = card;
            active--;
            finished++;
            pump();
          });
        })(next++);
      }
    }

    if (!items.length) return complete([]);
    pump();
  }

  function component(object) {
    var comp = new Lampa.InteractionCategory(object);
    comp.create = function () {
      var self = this;
      loadData(function (json) {
        resolveAll(json.watchlist || [], function (cards) {
          cards=combinedWatchCards(cards,json);
          self.build({
            results: cards,
            page: 1,
            total_pages: 1,
            total_results: cards.length,
            nomore: true
          });
        });
      }, this.empty.bind(this));
    };
    comp.nextPageReuest = function (params, resolve) {
      resolve({ results: [], page: 1, nomore: true });
    };
    return comp;
  }

