(function () {
  'use strict';
  // roman-home-layout-v074

  var DATA_URL = '__RECOMMENDER_PUBLIC_URL__/data.json';
  var CARD_RATINGS_URL = '__RECOMMENDER_PUBLIC_URL__/card-ratings.json';
  if (window.HomeCinemaProfiles) {
    DATA_URL = window.HomeCinemaProfiles.apiBase() + '/data.json';
    CARD_RATINGS_URL = window.HomeCinemaProfiles.apiBase() + '/card-ratings.json';
  }
  var COMPONENT = 'roman_kinopoisk';
  var SHELF_COMPONENT = 'roman_home_shelf';
  var REVIEW_COMPONENT = 'roman_recommendation_review';
  var reviewItems = {};
  var reviewCards = {};
  var reviewLabels = {want: 'Хочу посмотреть', not_interested: 'Не интересно', seen: 'Уже смотрел'};
  var reviewBase = DATA_URL.replace(/\/data\.json$/, '');
  window.RomanTracksApi = reviewBase;
  var reviewMissing = {};

  var homeFeedbackRevision = 0;
  function hiddenHomeCards(cards) {
    var hidden = Lampa.Storage.get('roman_hidden_home_v1', {});
    return (cards || []).filter(function (card) {
      var item = reviewForCard(card);
      return !hidden[String(card.kinopoisk_id || (item && item.kp_id) || '')];
    });
  }
  function rememberHidden(kp, status) {
    var hidden = Lampa.Storage.get('roman_hidden_home_v1', {});
    if (status === 'not_interested') hidden[String(kp)] = true;
    else delete hidden[String(kp)];
    Lampa.Storage.set('roman_hidden_home_v1', hidden);
    homeFeedbackRevision++;
  }

  function filterReviewItems(items, filters) {
    var result = items.filter(function (item) {
      var year = Number(item.release_year || 0), current = new Date().getFullYear();
      if (filters.period === 'recent' && !(year >= current-4 && year <= current)) return false;
      if (filters.period === 'archive' && !(year > 0 && year < current-4)) return false;
      return (!filters.type || item.media_type === filters.type) &&
        (!filters.year || Number(item.release_year) === Number(filters.year)) &&
        (!filters.rating || Number(item.kp_rating || 0) >= Number(filters.rating)) &&
        (!filters.country || (item.countries || []).indexOf(filters.country) !== -1) &&
        (!filters.genre || (item.genres || []).indexOf(filters.genre) !== -1) &&
        (!filters.status || (filters.status === 'new' ? !item.feedback : item.feedback === filters.status));
    });
    var key = {year:'release_year', rating:'kp_rating', votes:'kp_vote_count', relevance:'final_score'}[filters.sort || 'relevance'];
    result.sort(function (a, b) {
      if (filters.sort === 'title') return String(a.title).localeCompare(String(b.title), 'ru');
      return Number(b[key] || 0) - Number(a[key] || 0) || Number(a.kp_id) - Number(b.kp_id);
    });
    return result;
  }

  function openReviewList(period) {
    Lampa.Activity.push({url:'', title:'Рекомендация AI', component:REVIEW_COMPONENT, page:1,
      review_period:typeof period === 'string' ? period : 'recent'});
  }

  function showReviewFilters(returnToList, selectedField) {
    cachedReviewReport().then(function (report) {
      var items = report.items || [];
      var filters = Lampa.Storage.get('roman_review_filters_v1', {});
      function values(key) {
        var unique = {};
        items.forEach(function (item) {
          var list = Array.isArray(item[key]) ? item[key] : [item[key]];
          list.forEach(function (value) { if (value) unique[String(value)] = true; });
        });
        return Object.keys(unique).sort(function (a,b) {return key === 'release_year' ? Number(b)-Number(a) : a.localeCompare(b,'ru');})
          .map(function (value) {return {title:value, value:value};});
      }
      var fields = [
        {key:'period',title:'Период',values:[{title:'Последние пять лет',value:'recent'},{title:'Из прошлых лет',value:'archive'}]},
        {key:'type',title:'Тип',values:[{title:'Фильмы',value:'movie'},{title:'Сериалы',value:'tv'}]},
        {key:'year',title:'Год',values:values('release_year')},
        {key:'rating',title:'Рейтинг КП от',values:[5,6,7,8,9].map(function (v) {return {title:String(v),value:String(v)};})},
        {key:'country',title:'Страна',values:values('countries')},
        {key:'genre',title:'Жанр',values:values('genres')},
        {key:'status',title:'Моя отметка',values:[{title:'Без отметки',value:'new'}].concat(Object.keys(reviewLabels).map(function (key) {return {title:reviewLabels[key],value:key};}))},
        {key:'sort',title:'Сортировка',values:[{title:'Релевантность',value:'relevance'},{title:'Сначала новые',value:'year'},{title:'Рейтинг КП',value:'rating'},{title:'Количество оценок',value:'votes'},{title:'Название',value:'title'}]}
      ];
      function menu() {
        var rows = [{title:'Показать: ' + filterReviewItems(items,filters).length, key:'show'}];
        fields.forEach(function (field) {
          var selected = field.values.filter(function (v) {return v.value === filters[field.key];})[0];
          rows.push({title:field.title + ': ' + (selected ? selected.title : (field.key === 'sort' ? 'Релевантность' : 'Все')), field:field});
        });
        rows.push({title:'Сбросить фильтры',key:'reset'});
        var missing = Object.keys(reviewMissing);
        if (missing.length) rows.push({title:'Не удалось сопоставить: ' + missing.length,key:'missing'});
        Lampa.Select.show({title:'Фильтры рекомендаций',items:rows,onBack:function () {Lampa.Controller.toggle('content');},onSelect:function (row) {
          if (row.key === 'show') {Lampa.Storage.set('roman_review_filters_v1',filters); if(returnToList) returnToList(); else openReviewList();return;}
          if (row.key === 'reset') {filters={};Lampa.Storage.set('roman_review_filters_v1',filters);menu();return;}
          if (row.key === 'missing') {
            Lampa.Select.show({title:'Не сопоставлены с каталогом Lampa',items:missing.map(function (id) {return {title:reviewMissing[id],subtitle:'Поиск не дал карточку. Это не проверка наличия видео.'};}),onBack:menu,onSelect:menu});return;
          }
          var field = row.field;
          Lampa.Select.show({title:field.title,items:[{title:field.key === 'sort' ? 'Релевантность' : 'Все',value:''}].concat(field.values),onBack:menu,onSelect:function (choice) {
            filters[field.key]=choice.value; Lampa.Storage.set('roman_review_filters_v1',filters);menu();
          }});
        }});
      }
      if (selectedField) {
        var field = fields.filter(function (entry) { return entry.key === selectedField; })[0];
        Lampa.Select.show({title:field.title,items:[{title:'Все / по умолчанию',value:''}].concat(field.values),
          onBack:function () {Lampa.Controller.toggle('content');},onSelect:function (choice) {
            filters[field.key]=choice.value;
            Lampa.Storage.set('roman_review_filters_v1',filters);
            returnToList();
          }});
      } else menu();
    }).catch(function (error) {Lampa.Noty.show('Не удалось загрузить фильтры: '+error.message);});
  }

  function reviewRequest(path, payload) {
    return new Promise(function(resolve,reject){
      var request=new Lampa.Reguest();
      request.timeout(8000);
      request.silent(reviewBase+path,resolve,function(){reject(new Error('Сервис рекомендаций не ответил'));},
        payload ? JSON.stringify(payload) : false,
        payload ? {type:'POST',headers:{'Content-Type':'application/json'}} : {});
    });
  }

  var reviewSnapshotFlight=null;
  function cachedReviewReport() {
    var key='roman_review_snapshot_v4';
    var cached=Lampa.Storage.get(key,null);
    if(!reviewSnapshotFlight) {
      reviewSnapshotFlight=reviewRequest('/review-cached.json'+(cached && cached.revision ? '?revision='+encodeURIComponent(cached.revision):''))
        .then(function(report) {
          if(report.unchanged) return cached;
          if(report.warming && cached) return cached;
          if(!report.warming && Array.isArray(report.items)) {
            try {Lampa.Storage.set(key,report);} catch(error) {}
          }
          return report;
        }).catch(function(error){if(cached)return cached;throw error;})
        .then(function(report){reviewSnapshotFlight=null;return report;},function(error){reviewSnapshotFlight=null;throw error;});
    }
    if(cached && Array.isArray(cached.items)) {
      // Refresh in the background; never hold a previously opened list behind I/O.
      reviewSnapshotFlight.catch(function(){});
      return Promise.resolve(cached);
    }
    return reviewSnapshotFlight;
  }

  function reviewForCard(card) {
    return card && (reviewItems[String(card.kinopoisk_id || '')] ||
      reviewCards[(card.media_type || (card.name || card.first_air_date ? 'tv' : 'movie')) + ':' + card.id]);
  }

  function markReview(element, item) {
    var view = element && element.querySelector('.card__view');
    if (!view || !item) return;
    element.classList.add('roman-review-card');
    var badge = element.querySelector('.roman-review-mark');
    if (!badge) {
      badge = document.createElement('div');
      badge.className = 'roman-review-mark';
      badge.style.cssText = 'color:#aac9ef;font-size:.75em;padding-top:.3em;pointer-events:none';
      element.appendChild(badge);
    }
    badge.textContent = item.feedback ? '✓ ' + reviewLabels[item.feedback] : '';
  }

  function installTailLoading() {
    var Native=Lampa.InteractionCategory;
    if(typeof Native!=='function' || Native.romanTailLoading)return;
    if(!document.getElementById('roman-tail-style')) {
      var style=document.createElement('style');style.id='roman-tail-style';
      style.textContent='.roman-loading-tail{display:flex;align-items:center;justify-content:center;min-height:7em;width:100%;clear:both;flex-shrink:0;grid-column:1/-1;pointer-events:none}.roman-loading-tail i{display:block;width:2em;height:2em;border:.2em solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:roman-tail-spin .8s linear infinite}@keyframes roman-tail-spin{to{transform:rotate(360deg)}}';
      document.head.appendChild(style);
    }
    function decorate(comp) {
      var loaded=false,tail=null,destroyed=false;
      function hide(){if(tail)tail.remove();tail=null;}
      function show(){
        if(destroyed || tail)return;
        var root=comp.render(),host=root.find('.category__items,.content__items,.items__body,.scroll__body').first();
        if(!host.length)host=root;
        tail=$('<div class="roman-loading-tail" role="status" aria-label="Загрузка продолжения"><i></i></div>');
        host.append(tail);
      }
      function wrap(name,transform) {
        var fn=comp[name],wrapped=typeof fn==='function'?transform(fn):fn;
        Object.defineProperty(comp,name,{configurable:true,enumerable:true,
          get:function(){return wrapped;},set:function(value){wrapped=typeof value==='function'?transform(value):value;}});
      }
      wrap('build',function(fn){return function(data){var result=fn.apply(this,arguments);if(data && data.results && data.results.length)loaded=true;hide();return result;};});
      wrap('nextPageReuest',function(fn){return function(params,resolve){
        show();
        var args=Array.prototype.slice.call(arguments),answered=false;
        args[1]=function(){if(answered)return;answered=true;hide();return resolve.apply(this,arguments);};
        if(typeof args[2]==='function') {var failed=args[2];args[2]=function(){hide();return failed.apply(this,arguments);};}
        try{return fn.apply(this,args);}catch(error){hide();throw error;}
      };});
      // Keep native first-load behavior; only replace blocking loaders after cards exist.
      if(typeof comp.loading==='function')wrap('loading',function(fn){return function(value){
        if(loaded && value){show();return;}
        if(!value)hide();return fn.apply(this,arguments);
      };});
      if(typeof comp.destroy==='function')wrap('destroy',function(fn){return function(){destroyed=true;hide();return fn.apply(this,arguments);};});
      return comp;
    }
    function Category(object){return decorate(new Native(object));}
    Category.prototype=Native.prototype;
    Category.romanTailLoading=true;
    Lampa.InteractionCategory=Category;
  }

  function reviewComponent(object) {
    var comp = new Lampa.InteractionCategory(object);
    var originalBuild = comp.build;
    var originalEmpty = comp.empty;
    var originalStart = comp.start;
    function toolbar() {
      var root = comp.render();
      if (root.find('.roman-ai-toolbar').length) return;
      var bar = $('<div class="roman-ai-toolbar"></div>');
      function reload() {Lampa.Activity.replace({url:'',title:'Рекомендация AI',component:REVIEW_COMPONENT,page:1});}
      var labels = {period:'Период',type:'Тип',year:'Год',rating:'КП от',country:'Страна',genre:'Жанр',status:'Отметка',sort:'Сортировка'};
      var values = {recent:'Последние пять лет',archive:'Из прошлых лет',movie:'Фильмы',tv:'Сериалы',new:'Без отметки',relevance:'Релевантность',year:'Сначала новые',rating:'Рейтинг КП',votes:'Число оценок',title:'Название'};
      Object.keys(labels).forEach(function (key) {
        var value = filters[key];
        var text = labels[key] + ': ' + (values[value] || reviewLabels[value] || value || (key === 'sort' ? 'Релевантность' : 'Все'));
        $('<div class="selector simple-button"></div>').text(text).on('hover:enter',function () {
          showReviewFilters(reload,key);
        }).appendTo(bar);
      });
      $('<div class="selector simple-button">Сбросить</div>').on('hover:enter',function () {
        Lampa.Storage.set('roman_review_filters_v1',{});reload();
      }).appendTo(bar);
      $('<span>Прогноз ≈ — предварительная личная оценка</span>').appendTo(bar);
      root.prepend(bar);
    }
    comp.build = function (data) { toolbar(); originalBuild.call(this,data); };
    comp.empty = function () { originalEmpty.call(this); toolbar(); };
    comp.start = function () {
      originalStart.call(this);
      Lampa.Controller.collectionSet(comp.render());
    };
    var snapshot = null;
    var filters = Lampa.Storage.get('roman_review_filters_v1', {});
    if (object.review_period) {
      filters=Object.assign({},filters,{period:object.review_period});
      Lampa.Storage.set('roman_review_filters_v1',filters);
    }
    function page(number, done, failed) {
      if (!snapshot) snapshot = cachedReviewReport();
      snapshot.then(function (report) {
        var items = filterReviewItems(report.items || [], filters);
        items.forEach(function (item) { reviewItems[String(item.kp_id)] = item; });
        var slice = items.slice((number - 1) * 12, number * 12);
        var ready=slice.filter(function(item){return item.card;}).map(function(item){
          return Object.assign({},item.card,{kinopoisk_id:String(item.kp_id)});
        });
        resolveAll(slice.filter(function(item){return !item.card;}).map(function (item) {
          return {kp_id: item.kp_id, title: item.title, year: item.release_year, media_type: item.media_type};
        }), function (missingCards) {
          var cards=ready.concat(missingCards).sort(function(a,b){
            return slice.findIndex(function(i){return String(i.kp_id)===String(a.kinopoisk_id);})-
                   slice.findIndex(function(i){return String(i.kp_id)===String(b.kinopoisk_id);});
          });
          cards.forEach(function (card) {
            var item = reviewItems[String(card.kinopoisk_id)];
            if (!item) return;
            reviewCards[item.media_type + ':' + card.id] = item;
          });
          slice.forEach(function (item) {
            if (!cards.some(function (card) {return String(card.kinopoisk_id) === String(item.kp_id);})) reviewMissing[String(item.kp_id)] = item.title;
            else delete reviewMissing[String(item.kp_id)];
          });
          done({results: filterReleaseCards(cards), page: number, total_pages: Math.max(1, Math.ceil(items.length / 12)),
            total_results: items.length, nomore: number * 12 >= items.length});
        });
      }).catch(function (error) {
        Lampa.Noty.show('Рекомендации пока недоступны: ' + error.message);
        if (failed) failed();
      });
    }
    comp.create = function () {
      page(Number(object.page || 1), this.build.bind(this), this.empty.bind(this));
    };
    comp.nextPageReuest = function (params, resolve) {
      page(Number(params.page || 2), resolve, function () { resolve({results: [], nomore: true}); });
    };
    return comp;
  }

  function addReviewMenu() {
    $('.menu__item.roman-review,.menu__item.roman-review-filters').remove();
  }

  function addReviewActions(event) {
    if (!event || event.type !== 'complite' || !event.data || !event.data.movie) return;
    $('.button--roman-review').remove();
    var item = reviewForCard(event.data.movie);
    if (!item) return;
    var host = $('.full-start-new__buttons');
    if (!host.length) host = $('.full-start__buttons');
    if (!host.length) return;
    var button = $('<div class="full-start__button selector button--roman-review" title="Для меня"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="9" cy="18" r="2"/></svg><span>Для меня</span></div>');
    var busy = false;
    function explain() {
      var reasons = item.reasons || {};
      var lines = [{title: 'Прогноз ≈ ' + Number(item.predicted_rating || 0).toFixed(1), subtitle: 'Предварительный расчёт по вашим предпочтениям. Это не поставленная вами оценка; точность ещё проверяем.'}];
      (reasons.positive_features || []).forEach(function (feature) {
        lines.push({title: 'Поддерживает: ' + feature.name, subtitle: 'По вашим оценкам похожих произведений'});
      });
      (reasons.negative_features || []).forEach(function (feature) {
        lines.push({title: 'Снижает интерес: ' + feature.name});
      });
      lines.push({title: 'Массовость', subtitle: 'Оценок на Кинопоиске: ' + (item.kp_vote_count || 0)});
      Lampa.Select.show({title: 'Почему: ' + item.title, items: lines,
        onSelect: function () { Lampa.Controller.toggle('full'); },
        onBack: function () { Lampa.Controller.toggle('full'); }});
    }
    function save(status) {
      if (busy) return;
      busy = true;
      reviewRequest('/review-feedback.json', {kp_id: item.kp_id, status: status})
        .then(function (result) {
          item.feedback = result.status;
          rememberHidden(item.kp_id, result.status);
          data=null;
          if(result.status==='want' && Lampa.Favorite && typeof Lampa.Favorite.add==='function')
            Lampa.Favorite.add('wath',event.data.movie);
          Array.prototype.forEach.call(document.querySelectorAll('.card'), function (element) {
            var found = reviewForCard(element.card_data);
            if (found && found.kp_id === item.kp_id) markReview(element, item);
          });
          Lampa.Noty.show(result.status === 'not_interested' ? 'Скрыто из продолжения и рекомендаций' : result.status ? 'Сохранено: ' + reviewLabels[result.status] : 'Отметка снята');
        }).catch(function (error) { Lampa.Noty.show('Не сохранено: ' + error.message); })
        .then(function () { busy = false; });
    }
    button.on('hover:enter', function () {
      var entries = Object.keys(reviewLabels).map(function (status) {
        return {title: (item.feedback === status ? '✓ ' : '') + reviewLabels[status], status: status,
          subtitle: status === 'not_interested' ? 'Убрать из продолжения просмотра и рекомендаций' : ''};
      });
      if (item.feedback) entries.push({title: 'Снять отметку', status: 'clear'});
      if (item.predicted_rating != null) entries.push({title: 'Почему предложено', explain: true});
      Lampa.Select.show({title: 'Для меня', items: entries,
        onSelect: function (selected) {
          // Native Select hides the menu before invoking onSelect.
          if (selected.explain) explain(); else {save(selected.status);Lampa.Controller.toggle('full');}
        },
        onBack: function () {Lampa.Controller.toggle('full');}
      });
    });
    host.append(button);
  }

  // Scope the replacement to CUB home responses, including subsequent row batches.
  // A failed personal service leaves the original CUB rows usable.
  function sameHomeCard(a,b) {
    var ak=a.kinopoisk_id || a.kp_id || (a.roman_review && a.roman_review.kp_id);
    var bk=b.kinopoisk_id || b.kp_id || (b.roman_review && b.roman_review.kp_id);
    if(ak && bk) return String(ak)===String(bk);
    function type(c){return c.media_type || (c.original_name || c.first_air_date || c.name ? 'tv':'movie');}
    return a.id != null && b.id != null && String(a.id)===String(b.id) && type(a)===type(b) &&
      (a.source || 'cub')===(b.source || 'cub');
  }

  function nativeFavorite(type) {
    if(!Lampa.Favorite || typeof Lampa.Favorite.get!=='function') return [];
    return Lampa.Favorite.get({type:type}) || [];
  }

  function combinedWatchCards(cards, catalog) {
    catalog=catalog || (typeof data!=='undefined' && data) || {};
    var planned=nativeFavorite('wath').concat(nativeFavorite('scheduled'));
    var viewed=nativeFavorite('viewed'), rated=catalog.ratings || [];
    var result=[];
    (cards || []).concat(planned).forEach(function(card) {
      var review=reviewForCard(card) || {}, cached=cacheGet(ratingKey(card)) || {};
      if(Number(review.my_rating || cached.my_rating || card.my_rating ||
          (card.roman_review && card.roman_review.my_rating))>0) return;
      if(rated.some(function(item){return sameHomeCard(card,item);}) ||
          viewed.some(function(item){return sameHomeCard(card,item);})) return;
      if(review.feedback==='seen' || review.feedback==='not_interested') return;
      var tv=card.media_type==='tv' || card.original_name || card.first_air_date || card.name;
      if(!tv && Lampa.Timeline && typeof Lampa.Timeline.watched==='function') {
        var progress=Lampa.Timeline.watched(card,true);
        if(progress && Number(progress.percent)>=90) return;
      }
      if(!result.some(function(old){return sameHomeCard(old,card);})) result.push(card);
    });
    return filterReleaseCards(result);
  }

  var continueDisplayCards=[];
  function releaseForCard(card) {
    var saved=Lampa.Storage.get('roman_home_shelves_releases_v1',{});
    var releases=saved && Array.isArray(saved.items)?saved.items:[];
    var kp=card.kinopoisk_id || (card.roman_review && card.roman_review.kp_id);
    var matches=kp?releases.filter(function(r){return String(r.kp_id)===String(kp);}):[];
    if(!matches.length && (card.source || 'cub').match(/^(cub|tmdb)$/))
      matches=releases.filter(function(r){return r.tmdb_id && String(r.tmdb_id)===String(card.id || card.tmdb_id);});
    if(!matches.length) {
      var name=String(card.original_name || card.original_title || '').trim().toLowerCase();
      var year=String(card.first_air_date || card.release_date || card.release_year || '').slice(0,4);
      if(name && year) matches=releases.filter(function(r){return String(r.original_title || '').trim().toLowerCase()===name && String(r.release_year)===year;});
    }
    return matches.length===1?matches[0]:null;
  }

  function caughtUpSeries(card) {
    if(!(card.original_name || card.first_air_date || card.media_type==='tv')) return false;
    var release=releaseForCard(card);
    if(!release) return false;
    var last=lastHomeEpisode(card);
    // Preserve an active earlier episode (including rewatches) even if an old
    // timeline entry happens to mark a later finale complete.
    if(last && (Number(last.season)!==Number(release.season) || Number(last.episode)!==Number(release.episode))) return false;
    var now=new Date(),today=now.getFullYear()+'-'+('0'+(now.getMonth()+1)).slice(-2)+'-'+('0'+now.getDate()).slice(-2);
    // A stored schedule stops proving completion when its next episode is due.
    if(release.next_air_date && release.next_air_date<=today) return false;
    if(!Lampa.Timeline) return false;
    var percent=0;
    if(typeof Lampa.Timeline.watchedEpisode==='function')
      percent=Number(Lampa.Timeline.watchedEpisode(card,release.season,release.episode));
    else if(typeof Lampa.Timeline.view==='function') {
      var name=card.original_name || card.original_title;
      if(!name) return false;
      var hash=Lampa.Utils.hash([release.season,release.season>10?':':'',release.episode,name].join(''));
      percent=Number((Lampa.Timeline.view(hash) || {}).percent);
    }
    return isFinite(percent) && percent>=90;
  }

  function continueHomeCards(cards) {
    return (cards || []).filter(function(card){return !caughtUpSeries(card);}).map(function(card){
      var display=Object.assign({},card);
      continueDisplayCards.push(display);
      if(continueDisplayCards.length>1000) continueDisplayCards.shift();
      return display;
    });
