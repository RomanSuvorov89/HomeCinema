/* roman TV bootstrap 0.7.4; generated payload stays in the server lampainit response. */
(function () {
    if (window.romanBootstrap054) return;
    window.romanBootstrap054 = true;
    var count = 0, started = Date.now(), wrapped = false;
    function report(stage, message) {
        if (count++ >= 30) return;
        try {
            var request = new XMLHttpRequest();
            request.open('POST', '__RECOMMENDER_PUBLIC_URL__/client-diagnostics.json', true);
            request.timeout = 2500;
            request.setRequestHeader('Content-Type', 'text/plain');
            request.send(JSON.stringify({version:'0.7.4', stage:stage,
                message:String(message || '').replace(/https?:\/\/[^\s)]+/g, function (url) {return url.split('?')[0];}).slice(0,1800),
                agent:navigator.userAgent.slice(0,400)}));
        } catch (_) {}
    }
    window.romanClientReport = report;
    /* homecinema-card-metadata:start */
    function localMetadataCards() {
        // CUB's client-side block list gates metadata cards before the catalog
        // request. Use the native switch, including for late-loaded clients.
        window.lampa_settings = window.lampa_settings || {};
        window.lampa_settings.disable_features = window.lampa_settings.disable_features || {};
        window.lampa_settings.disable_features.dmca = true;
        window.lampa_settings.dcma = [];
        if (!(window.Lampa && Lampa.Utils && typeof Lampa.Utils.dcma === 'function') ||
            Lampa.Utils.dcma.homecinemaMetadataCards) return;
        // A /blocked request already in flight can repopulate the native list.
        // The public metadata gate must remain open after that late response.
        Lampa.Utils.dcma = function () { return false; };
        Lampa.Utils.dcma.homecinemaMetadataCards = true;
    }
    function metadataFallback() {
        if (!(window.Lampa && Lampa.Api && typeof Lampa.Api.full === 'function' &&
              Lampa.Api.sources && Lampa.Api.sources.tmdb && typeof Lampa.Api.sources.tmdb.full === 'function') ||
              Lampa.Api.full.homecinemaMetadataFallback) return;
        var original = Lampa.Api.full;
        Lampa.Api.full = function (params, complete, error) {
            var receiver = this;
            return original.call(receiver,params,function (data) {
                if (!(data && data.movie && data.movie.blocked) ||
                    !/^(cub|tmdb)$/.test(params.source || 'cub')) return complete(data);
                var fallback = Object.assign({},params,{source:'tmdb'});
                var settled = false;
                var timer = setTimeout(function () { fail({timeout:true}); },20000);
                function fail(reason) {
                    if (settled) return;
                    settled = true; clearTimeout(timer);
                    if (error) error(reason);
                }
                return Lampa.Api.sources.tmdb.full(fallback,function (result) {
                    if (settled) return;
                    if (!(result && result.movie && String(result.movie.id) === String(params.id) && !result.movie.blocked)) return fail();
                    settled = true; clearTimeout(timer);
                    var prior = params.card || {};
                    if (prior.kinopoisk_id && !result.movie.kinopoisk_id) result.movie.kinopoisk_id = prior.kinopoisk_id;
                    complete(result);
                },fail);
            },error);
        };
        Lampa.Api.full.homecinemaMetadataFallback = true;
    }
    localMetadataCards();
    metadataFallback();
    /* homecinema-card-metadata:end */
    /* homecinema-local-reactions:start */
    function localReactions() {
        if (!Lampa.Utils || typeof Lampa.Utils.imgLoad !== 'function' || Lampa.Utils.imgLoad.homecinemaReactions) return;
        // These five decorative icons belong to the client. Do not fetch them
        // through CUB: its image endpoint can return an HTML 403 response.
        var drawings = {
            fire: '<path fill="#ff9838" d="M16 2C18 10 28 12 28 21a12 12 0 0 1-24 0c0-6 4-10 7-13-1 6 1 8 3 9 3-4 4-8 2-15Z"/><path fill="#ffe399" d="M17 15c0 5 6 6 6 10a7 7 0 0 1-14 0c0-3 2-6 4-7-1 4 1 5 2 5 2-2 3-5 2-8Z"/>',
            nice: '<path fill="#ffd16b" stroke="#d99536" stroke-width="1.5" stroke-linejoin="round" d="M11 27H5V14h6Zm1-12 5-7V3c5 0 6 5 4 10h5c3 0 3 3 2 6l-2 8H12Z"/>',
            think: '<circle cx="16" cy="16" r="14" fill="#ffd16b"/><path d="m7 10 5-1m8 0 5 2M11 22l10-2" fill="none" stroke="#654421" stroke-width="2" stroke-linecap="round"/><circle cx="11" cy="14" r="1.6" fill="#654421"/><circle cx="22" cy="15" r="1.6" fill="#654421"/><path d="m14 29 2-9c1-3 4-2 3 1l-1 4 7-2c3 0 3 3 0 4l-5 3Z" fill="#ffe3a3" stroke="#d99536"/>',
            bore: '<circle cx="16" cy="16" r="14" fill="#a8bbd2"/><path d="M7 12h6m6 0h6M11 23h10" fill="none" stroke="#35465e" stroke-width="2.3" stroke-linecap="round"/>',
            shit: '<path fill="#ad7753" d="M18 2c4 7-2 7 2 10 7-1 10 5 5 8 8 0 9 10 1 10H6c-8 0-6-10 1-10-5-4-1-9 4-8-3-5 6-5 7-10Z"/><ellipse cx="12" cy="20" rx="3" ry="4" fill="white"/><ellipse cx="21" cy="20" rx="3" ry="4" fill="white"/><circle cx="12" cy="21" r="1.5" fill="#33251d"/><circle cx="21" cy="21" r="1.5" fill="#33251d"/><path d="M13 26q4 3 8 0" fill="none" stroke="#33251d" stroke-width="1.5" stroke-linecap="round"/>'
        };
        var icons = {};
        Object.keys(drawings).forEach(function (type) {
            icons[type] = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' + drawings[type] + '</svg>');
        });
        function icon(url) {
            var match = String(url || '').match(/\/img\/reactions\/(fire|nice|think|bore|shit)\.svg(?:[?#].*)?$/);
            return match && icons[match[1]];
        }
        var original = Lampa.Utils.imgLoad;
        Lampa.Utils.imgLoad = function (image, src, onload, onerror) {
            return original.call(this, image, icon(src) || src, onload, onerror);
        };
        Lampa.Utils.imgLoad.homecinemaReactions = true;
        // The reaction picker uses raw <img src>, not Utils.imgLoad.
        function repair(root) {
            if (!root || root.nodeType !== 1) return;
            function replace(image) {
                var source = icon(image.getAttribute('src'));
                if (source) image.setAttribute('src', source);
            }
            if (root.tagName === 'IMG') replace(root);
            Array.prototype.forEach.call(root.querySelectorAll('img'), replace);
        }
        repair(document.body);
        if (window.MutationObserver) {
            new MutationObserver(function (records) {
                records.forEach(function (record) {
                    if (record.type === 'attributes') repair(record.target);
                    else Array.prototype.forEach.call(record.addedNodes, repair);
                });
            }).observe(document.body, {childList:true, subtree:true, attributes:true, attributeFilter:['src']});
        }
    }
    /* homecinema-local-reactions:end */
    window.addEventListener('error', function (e) {
        report('error', (e.message || 'Resource failed') + ' ' + (e.filename || (e.target && e.target.src) || '') + ':' + (e.lineno || '') + ' ' + (e.error && e.error.stack || ''));
    }, true);
    window.addEventListener('unhandledrejection', function (e) {report('promise', e.reason && (e.reason.stack || e.reason.message) || e.reason);});
    function own(url) {return String(url).split('?')[0].split('#')[0] === '__RECOMMENDER_PUBLIC_URL__/kinopoisk.js' && window.romanEmbedded054;}
    function quietStartup() {
        if (Lampa.Noty && typeof Lampa.Noty.show === 'function' && !Lampa.Noty.show.homecinemaQuietSuccess) {
            var originalShow = Lampa.Noty.show;
            Lampa.Noty.show = function (message) {
                if (typeof message === 'string') {
                    var text = message.trim();
                    var translated = Lampa.Lang && Lampa.Lang.translate('plugins_add_success');
                    if (text === 'Плагин успешно подключен' ||
                        (translated && translated !== 'plugins_add_success' && text === translated)) return;
                }
                return originalShow.apply(this, arguments);
            };
            Lampa.Noty.show.homecinemaQuietSuccess = true;
        }
        if (document.head && !document.getElementById('homecinema-quiet-startup')) {
            var style = document.createElement('style');
            style.id = 'homecinema-quiet-startup';
            // Upstream halloween promotion can append its button after startup.
            // Keep settings, search, profile and notification controls untouched.
            style.textContent = '.head .halloween__button{display:none!important}';
            document.head.appendChild(style);
        }
    }
    function wrapLoaders() {
        if (wrapped || !Lampa.Utils || !Lampa.Platform) return;
        wrapped = true;
        var android = Lampa.Platform && Lampa.Platform.is('android');
        ['putScriptAsync','putScript'].forEach(function (method) {
            var original = Lampa.Utils[method];
            if (typeof original !== 'function') return;
            Lampa.Utils[method] = function (items, complete, error, success, logs) {
                var pending = items.filter(function (url) {
                    var external = android && Lampa.Storage && Lampa.Storage.get('player_torrent','android') === 'android';
                    var skipGst = external && /\/(?:gst\.js|gst\/tracks\.js)(?:[?#]|$)/.test(url);
                    if (skipGst) report('external player','Skip browser GStreamer: '+url);
                    var legacySync = window.HomeCinemaProfiles && window.HomeCinemaProfiles.ownsHistory &&
                        /\/(?:sync|bookmark|timecode)(?:\.js|\/js\/)/.test(String(url));
                    if (own(url) || skipGst || legacySync) {if(success) success(url);return false;}return true;});
                if (!pending.length) {if (complete) complete();return;}
                if (!android) return original.call(Lampa.Utils,pending,complete,error,success,logs);
                var left = pending.length;
                function load(index) {
                    var url=pending[index], script=document.createElement('script'), done=false;
                    var timer=setTimeout(function () {finish(false,'timeout');},6000);
                    function finish(ok, reason) {
                        if (done) return;
                        done=true;clearTimeout(timer);script.onload=script.onerror=null;
                        if (!ok) {if(script.parentNode) script.parentNode.removeChild(script);report('plugin',url+' '+reason);}
                        try {if(ok) {if(success) success(url);} else if(error) error(url);}
                        catch(e) {report('plugin callback',e.stack || e.message);}
                        left--;
                        if (method === 'putScript' && index+1 < pending.length) load(index+1);
                        if (!left && complete) complete();
                    }
                    script.async=true;
                    script.onload=function () {finish(true);};
                    script.onerror=function () {finish(false,'network');};
                    script.src=url;document.body.appendChild(script);
                }
                if (method === 'putScript') load(0);
                else pending.forEach(function (_,i) {load(i);});
            };
        });
    }
    function boot() {
        if (window.Lampa && document.body) {localMetadataCards();metadataFallback();quietStartup();localReactions();wrapLoaders();}
        if (!(window.Lampa && Lampa.Storage && Lampa.Platform && Lampa.Component && Lampa.Listener && Lampa.Api && Lampa.Api.sources && Lampa.Api.sources.cub && document.body)) {
            if(Date.now()-started < 15000) setTimeout(boot,20);
            else report('bootstrap','Lampa API not ready');
            return;
        }
        function runPayload() {
        /* ROMAN_EMBEDDED_PAYLOAD */
        report('ready','home=' + !!Lampa.Api.sources.cub.main.romanAiHome + '; core=' + !!window.romanKinopoiskStarted + '; player=' + Lampa.Storage.get('player_torrent',''));
        }
        if (window.HomeCinemaProfiles) window.HomeCinemaProfiles.whenReady(runPayload);
        else runPayload();
    }
    boot();
})();
