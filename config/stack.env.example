# Copy to config/stack.env and edit before installation.
STACK_NAME=home-cinema
TZ=Europe/Moscow

# Addresses opened by TVs and computers. Use LAN IP or local DNS.
PUBLIC_LAMPAC_URL=http://192.168.1.10:9118
PUBLIC_TORRSERVER_URL=http://192.168.1.10:8090
PUBLIC_RECOMMENDER_URL=http://192.168.1.10:9120

LAMPAC_PORT=9118
TORRSERVER_PORT=8090
RECOMMENDER_PORT=9120

# Generate a long random value for real installations.
LAMPAC_ROOT_PASSWORD=CHANGE_ME

# Profile selected at install time from profiles.json.
ACTIVE_PROFILE_ID=owner

# Metadata queue. These defaults are intentionally polite.
ENRICH_BATCH_SIZE=100
ENRICH_WORKERS=10
KINOPOISK_METADATA_RPM=12
WIKIPEDIA_METADATA_RPM=20

# External plugins. Set to 0 if you want only server-owned plugins.
ENABLE_COMMUNITY_PLUGINS=0

PUBLIC_POSTER_URL=http://192.168.1.10:9121
POSTER_PORT=9121
